{{- $pctx := . -}}
{{- if .IsHome -}}{{ $pctx = .Site }}{{- end -}}
{{- $pages := slice -}}
{{- if or $.IsHome $.IsSection -}}
{{- $pages = $pctx.RegularPages -}}
{{- else -}}
{{- $pages = $pctx.Pages -}}
{{- end -}}
{{- $limit := .Site.Config.Services.RSS.Limit -}}
{{- /* 浏览器展示用 CSS 处理指令（替代已被 Chrome 移除的 XSLT），阅读器忽略它 */ -}}
{{- $css := resources.Get "css/atom.css" | resources.ExecuteAsTemplate "css/atom.css" . | minify | fingerprint -}}
{{- if ge $limit 1 -}}
{{- $pages = $pages | first $limit -}}
{{- end -}}
<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<?xml-stylesheet type="text/css" href="{{ $css.RelPermalink }}"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.Language }}">
  <id>{{ .Permalink }}</id>
  <title>{{ if eq .Title .Site.Title }}{{ .Site.Title | html }}{{ else }}{{ with .Title }}{{ . | html }} on {{ end }}{{ .Site.Title | html }}{{ end }}</title>
  <updated>{{ now.Format "2006-01-02T15:04:05Z07:00" }}</updated>
  <language>{{ site.Language }}</language>
  {{ with .Site.Params.description }}<subtitle>{{ . | html }}</subtitle>{{ end }}
  <author>
    <name>{{ (.Site.Params.author.name | default .Site.Params.Author.name) | html }}</name>
    {{ with .Site.Params.author.email | default .Site.Params.Author.email }}<email>{{ . | html }}</email>{{ end }}
    <uri>{{ .Site.BaseURL }}</uri>
  </author>
  {{- with .OutputFormats.Get "atom" -}}
  <link href="{{ .Permalink }}" rel="self" type="application/atom+xml" />
  {{- end -}}
  <link href="{{ .Permalink }}" rel="alternate" type="text/html" />
  <generator uri="https://gohugo.io" version="{{ hugo.Version }}">Hugo</generator>
  {{ if .Site.Params.footer.showCopyright | default true -}}
  <rights>{{ with replace .Site.Params.copyright "{ year }" now.Year }}{{ . }}{{ else }}© {{ now.Format "2006" }} {{ .Site.Params.author.name }}{{ end }}</rights>
  {{- end }}
  {{ range $pages }}
  {{- /* 剥离 github/gitea 等 shortcode 输出的 <script> 块：RSS 阅读器
        不执行脚本，相对路径的 /js/fetch-repo.* 在阅读器域名下 404，
        会留下空壳卡片并造成排版错乱；卡片静态信息（仓库名/描述/星数）
        已在构建时烘焙，剥离脚本不影响阅读。 */ -}}
  {{- $content := replaceRE "(?s)<script[^>]*>.*?</script>" "" .Content }}
  <entry>
    <id>{{ .Permalink }}</id>
    <title>{{ .Title | plainify | html }}</title>
    <published>{{ .Date.Format "2006-01-02T15:04:05Z07:00" }}</published>
    <updated>{{ with .Lastmod }}{{ .Format "2006-01-02T15:04:05Z07:00" }}{{ else }}{{ $.Date.Format "2006-01-02T15:04:05Z07:00" }}{{ end }}</updated>
    <author><name>{{ (.Site.Params.author.name | default .Site.Params.Author.name) | html }}</name></author>
    <link href="{{ .Permalink }}" rel="alternate" type="text/html" />
    {{ with .Summary }}<summary>{{ . | plainify | htmlUnescape | html }}</summary>{{ end }}
    <content type="html" xml:base="{{ .Permalink }}">{{ printf "<![CDATA[%s]]>" $content | safeHTML }}</content>
    {{ range .GetTerms "tags" }}<category term="{{ .Title | html }}" />{{ end }}
  </entry>
  {{ end }}
</feed>
